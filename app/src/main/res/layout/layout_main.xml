<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:statusBarBackground="@android:color/transparent"
    tools:openDrawer="start">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/fragment_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- We double trackThickness as half of it will be invisible -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/fabProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:max="1"
            android:visibility="invisible"
            app:indicatorColor="?primaryOrTextSecondary"
            app:layout_anchor="@+id/fab"
            app:layout_anchorGravity="center"
            app:layout_behavior="io.nekohasekai.sagernet.widget.FabProgressBehavior"
            app:trackCornerRadius="@dimen/mtrl_progress_track_thickness"
            app:trackThickness="8dp" />

        <io.nekohasekai.sagernet.widget.ServiceButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="6dp"
            android:nextFocusDown="@+id/stats"
            app:backgroundTint="?attr/fabColorBackground"
            app:layout_anchor="@id/stats"
            app:layout_anchorGravity="top|center_horizontal"
            app:pressedTranslationZ="6dp"
            app:srcCompat="@drawable/ic_service_idle" />

        <io.nekohasekai.sagernet.widget.StatsBar
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:nextFocusUp="@+id/fab"
            app:backgroundTint="?colorPrimary"
            app:contentInsetStart="0dp"
            app:hideOnScroll="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <!-- Row 1: 左侧 tx / rx (左肩垂直排布独享全宽)，中央 FAB 凹槽安全隔离，右侧 status 与 btn_ip_detail (右肩) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 左肩：tx / rx 速率区域（纵向排列各自独享全宽，自适应缩放彻底杜绝大字体截断） -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical|start"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tx"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="12sp"
                            app:autoSizeMaxTextSize="13sp"
                            app:autoSizeMinTextSize="9sp"
                            app:autoSizeStepGranularity="0.5sp"
                            app:autoSizeTextType="uniform"
                            tools:text="▲ 0 B/s" />

                        <TextView
                            android:id="@+id/rx"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="12sp"
                            app:autoSizeMaxTextSize="13sp"
                            app:autoSizeMinTextSize="9sp"
                            app:autoSizeStepGranularity="0.5sp"
                            app:autoSizeTextType="uniform"
                            tools:text="▼ 0 B/s" />

                    </LinearLayout>

                    <!-- 中央：FAB 悬浮球凹槽物理安全隔离空间 -->
                    <Space
                        android:layout_width="48dp"
                        android:layout_height="1dp" />

                    <!-- 右肩：status 延迟与重测刷新按钮（规整靠右对齐，上下两行排版防大字体截断） -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical|end"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end|center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/status_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:maxLines="1"
                                android:textSize="11sp"
                                android:visibility="gone"
                                app:autoSizeMaxTextSize="11sp"
                                app:autoSizeMinTextSize="8sp"
                                app:autoSizeStepGranularity="0.5sp"
                                app:autoSizeTextType="uniform"
                                tools:text="HTTPS 握手延迟"
                                tools:visibility="visible" />

                            <TextView
                                android:id="@+id/status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:maxLines="1"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="13sp"
                                app:autoSizeMinTextSize="9sp"
                                app:autoSizeStepGranularity="0.5sp"
                                app:autoSizeTextType="uniform"
                                tools:text="202ms" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/btn_ip_detail"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="6dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/retest"
                            android:padding="2dp"
                            android:src="@drawable/ic_baseline_refresh_24"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Row 2: 出站落地 IP 独占整行展示，支持大字体自适应与双行弹性折行 -->
                <TextView
                    android:id="@+id/status_ip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform"
                    tools:text="🇰🇷 KR 118.218.10.157"
                    tools:visibility="visible" />

            </LinearLayout>

        </io.nekohasekai.sagernet.widget.StatsBar>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <FrameLayout
        android:id="@+id/drawer_container"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start">

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            style="@style/Widget.MaterialComponents.NavigationView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="96dp"
            app:headerLayout="@layout/nav_header"
            app:insetForeground="@android:color/transparent"
            app:itemIconTint="@color/navigation_icon"
            app:itemShapeAppearance="@style/ShapeAppearance.SagerNet.NavItem"
            app:itemShapeFillColor="@color/nav_item_fill"
            app:itemShapeInsetBottom="2dp"
            app:itemShapeInsetEnd="12dp"
            app:itemShapeInsetStart="12dp"
            app:itemShapeInsetTop="2dp"
            app:itemIconPadding="16dp"
            app:itemIconSize="22dp"
            app:dividerInsetStart="9999dp"
            app:dividerInsetEnd="0dp"
            app:itemTextColor="@color/navigation_text"
            app:menu="@menu/main_drawer_menu" />

        <!-- Floating bottom action bar inside drawer: Left About [ⓘ] ... Right Settings [⚙] -->
        <LinearLayout
            android:id="@+id/drawer_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp"
            android:paddingTop="12dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <!-- Floating circular button for About (软件关于) - Left bottom -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_drawer_about"
                android:layout_width="46dp"
                android:layout_height="46dp"
                app:cardCornerRadius="23dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_stroke"
                app:cardBackgroundColor="?attr/colorSurface"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_about">

                <ImageView
                    android:id="@+id/iv_drawer_about"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_baseline_info_24"
                    app:tint="?android:attr/textColorPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Floating circular button for Settings (设置) - Right bottom -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_drawer_settings"
                android:layout_width="46dp"
                android:layout_height="46dp"
                app:cardCornerRadius="23dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_stroke"
                app:cardBackgroundColor="?attr/colorSurface"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings">

                <ImageView
                    android:id="@+id/iv_drawer_settings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_action_settings"
                    app:tint="?android:attr/textColorPrimary" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
