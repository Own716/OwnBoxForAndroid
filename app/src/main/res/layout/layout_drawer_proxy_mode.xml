<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_proxy_mode_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <!-- Section Header Title -->
    <TextView
        android:id="@+id/tv_proxy_mode_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp"
        android:text="@string/proxy_mode_title"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Row 1: Smart Routing & Global Mode Segmented Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <!-- 智能分流 -->
        <LinearLayout
            android:id="@+id/btn_mode_smart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_proxy_mode_btn_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/icon_mode_smart"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_baseline_compare_arrows_24"
                app:tint="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/text_mode_smart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/mode_smart_routing"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <!-- 全局模式 -->
        <LinearLayout
            android:id="@+id/btn_mode_global"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_proxy_mode_btn_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/icon_mode_global"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/baseline_public_24"
                app:tint="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/text_mode_global"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/mode_global_proxy"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: 分应用代理 -->
    <LinearLayout
        android:id="@+id/btn_app_proxy"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_proxy_mode_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/icon_app_proxy"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_navigation_apps"
            app:tint="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/text_app_proxy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/proxied_apps"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Status Chip -->
        <LinearLayout
            android:id="@+id/chip_app_proxy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_status_connected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/status_text_app_proxy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_enabled"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/status_dot_app_proxy"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_chip_status_connected" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: 自定义路由 -->
    <LinearLayout
        android:id="@+id/btn_custom_route"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_proxy_mode_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/icon_custom_route"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_hardware_router"
            app:tint="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/text_custom_route"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/custom_route"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Status Chip -->
        <LinearLayout
            android:id="@+id/chip_custom_route"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_status_disconnected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/status_text_custom_route"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_disabled"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/status_dot_custom_route"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_chip_status_disconnected" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
