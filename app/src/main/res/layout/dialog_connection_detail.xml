<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/connections_detail_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_detail_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_navigation_close"
            app:tint="?android:attr/textColorPrimary" />

    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/detail_tabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:tabGravity="fill"
        app:tabIndicatorColor="?attr/primaryOrTextPrimary"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabSelectedTextColor="?attr/primaryOrTextPrimary"
        app:tabTextColor="?android:attr/textColorSecondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Tab 1: Overview -->
            <LinearLayout
                android:id="@+id/layout_tab_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/landing_ip_section_basic"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="ID"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_id"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="monospace"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12sp"
                                tools:text="73350afc-5960-47b7-8af1" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="状态"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="活跃连接" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="类型"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_type"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="tun/tun-in | TCP (tls)" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="连接时间"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_time"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="1 分钟前" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="规则"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_rule"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="rule_set=geoip:cn => route(bypass)" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/detail_process_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="应用进程"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:id="@+id/detail_app_icon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/ic_navigation_apps" />

                            <TextView
                                android:id="@+id/detail_process"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:maxLines="2"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="QQ (com.tencent.mobileqq / 10384)" />
                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"
                    android:text="来源与目的"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="源 IP"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_source_ip"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="172.19.0.1" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="源端口"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_source_port"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="42372" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="主机"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_host"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="api.github.com:443" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="解析地址"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_dest_ip"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="20.205.243.168" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="解析类型"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_ip_version"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="IPv4" />
                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"
                    android:text="归属信息"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_detail_geo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/detail_geo_ip_asn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="2dp"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12.5sp"
                            tools:text="正在查询归属信息..." />

                        <TextView
                            android:id="@+id/detail_geo_location"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="2dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12.5sp"
                            android:visibility="gone"
                            tools:text="🇨🇳 中国"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/detail_geo_org"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="2dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12.5sp"
                            android:visibility="gone"
                            tools:text="China Mobile"
                            tools:visibility="visible" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"
                    android:text="流量"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="下载"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_download"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="#10B981"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                tools:text="6.82 KB" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="上传"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_upload"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="#3B82F6"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                tools:text="1.29 KB" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="下载速度"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_download_speed"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="0 B/s" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="上传速度"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_upload_speed"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="0 B/s" />
                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"
                    android:text="出站节点"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="代理链"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_chains"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="新加坡策略组 » Singapore 04" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="76dp"
                                android:layout_height="wrap_content"
                                android:text="出站节点"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/detail_outbound"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="Singapore 04 (VLESS)" />
                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Tab 2: Proxy Chain -->
            <LinearLayout
                android:id="@+id/layout_tab_proxy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/detail_proxy_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp" />

                <LinearLayout
                    android:id="@+id/detail_proxy_hops_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/detail_proxy_traffic_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    tools:text="实时速度：▼ 0 B/s  ▲ 0 B/s  ·  累计：▼ 6.82 KB  ▲ 1.29 KB" />

            </LinearLayout>

            <!-- Tab 3: Raw JSON -->
            <LinearLayout
                android:id="@+id/layout_tab_raw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="end">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy_raw_json"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/connections_copy_json"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_content_copy"
                        app:iconSize="16dp" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/detail_raw_json"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:padding="14dp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textIsSelectable="true"
                        android:textSize="11.5sp" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_detail_create_rule"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:text="@string/connections_create_rule"
            android:textSize="12sp"
            app:icon="@drawable/ic_baseline_add_road_24"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_detail_copy"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:text="@string/connections_copy"
            android:textSize="12sp"
            app:icon="@drawable/ic_content_copy"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_detail_close_conn"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:text="@string/connections_close_one"
            android:textColor="?attr/colorError"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
