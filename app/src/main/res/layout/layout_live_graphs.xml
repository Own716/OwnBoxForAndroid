<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.LiveGraphsFragment">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/live_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="96dp">

            <!-- Card 1: Throne-style Realtime Traffic Graph -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="@string/live_graph_traffic"
                            android:textAppearance="?android:attr/textAppearanceMedium"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/live_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/live_range_1m"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="42dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:text="1m"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/live_range_2m"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="42dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:text="2m"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/live_range_5m"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="42dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:text="5m"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/live_range_10m"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="42dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:text="10m"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <FrameLayout
                            android:layout_width="88dp"
                            android:layout_height="30dp">

                            <TextView
                                android:id="@+id/live_column_down"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="end|center_vertical"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:drawablePadding="5dp"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="4dp"
                                android:singleLine="true"
                                android:textAppearance="?android:attr/textAppearanceSmall"
                                android:textColor="?android:attr/textColorSecondary"
                                tools:text="↓ 下载" />

                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="88dp"
                            android:layout_height="30dp">

                            <TextView
                                android:id="@+id/live_column_up"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="end|center_vertical"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:drawablePadding="5dp"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="4dp"
                                android:singleLine="true"
                                android:textAppearance="?android:attr/textAppearanceSmall"
                                android:textColor="?android:attr/textColorSecondary"
                                tools:text="↑ 上传" />

                        </FrameLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/live_legend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <io.nekohasekai.sagernet.widget.LiveChartView
                        android:id="@+id/live_traffic_chart"
                        android:layout_width="match_parent"
                        android:layout_height="236dp"
                        android:layout_marginTop="6dp"
                        android:contentDescription="@string/live_graph_traffic" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/live_graph_legend_hint"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Core Process CPU, RAM & Active Connections -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/live_graph_core_title"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/live_graph_cpu"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/live_cpu_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="2.4%" />

                    </LinearLayout>

                    <io.nekohasekai.sagernet.widget.LiveChartView
                        android:id="@+id/live_cpu_chart"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@string/live_graph_cpu" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/live_graph_ram"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/live_ram_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="28.4 MB" />

                    </LinearLayout>

                    <io.nekohasekai.sagernet.widget.LiveChartView
                        android:id="@+id/live_ram_chart"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@string/live_graph_ram" />

                    <LinearLayout
                        android:id="@+id/live_connections_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="2dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/live_graph_connections"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/live_connections_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="12" />

                    </LinearLayout>

                    <io.nekohasekai.sagernet.widget.LiveChartView
                        android:id="@+id/live_connections_chart"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@string/live_graph_connections" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: 3-Dimension Persistent Traffic Statistics Table -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/traffic_stats_title"
                            android:textAppearance="?android:attr/textAppearanceMedium"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_stats_clear"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="2dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="8dp"
                            android:text="@string/traffic_stats_clear_short"
                            android:textAllCaps="false"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_baseline_delete_24"
                            app:iconPadding="4dp"
                            app:iconSize="16dp"
                            app:iconTint="?android:attr/textColorSecondary" />

                    </LinearLayout>

                    <!-- Period Selector -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/stats_period_chips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="6dp"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_period_session"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/traffic_stats_period_session"
                                android:textSize="12sp"
                                app:ensureMinTouchTargetSize="false" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_period_today"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/traffic_stats_period_today"
                                android:textSize="12sp"
                                app:ensureMinTouchTargetSize="false" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_period_7d"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/traffic_stats_period_7d"
                                android:textSize="12sp"
                                app:ensureMinTouchTargetSize="false" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_period_30d"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/traffic_stats_period_30d"
                                android:textSize="12sp"
                                app:ensureMinTouchTargetSize="false" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_period_all"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/traffic_stats_period_all"
                                android:textSize="12sp"
                                app:ensureMinTouchTargetSize="false" />

                        </com.google.android.material.chip.ChipGroup>

                    </HorizontalScrollView>

                    <!-- Summary Overview -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#0D808080"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/traffic_stats_summary_total"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tv_summary_total"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFeatureSettings="tnum"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="1.42 GB" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <View
                                        android:id="@+id/dot_summary_proxy"
                                        android:layout_width="7dp"
                                        android:layout_height="7dp"
                                        android:layout_marginEnd="5dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/live_graph_proxy"
                                        android:textColor="?android:attr/textColorSecondary"
                                        android:textSize="11sp" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_summary_proxy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFeatureSettings="tnum"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="12.5sp"
                                    android:textStyle="bold"
                                    tools:text="1.20 GB" />

                                <TextView
                                    android:id="@+id/tv_summary_proxy_detail"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="10sp"
                                    tools:text="↓ 1.1 GB  ↑ 100 MB" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <View
                                        android:id="@+id/dot_summary_direct"
                                        android:layout_width="7dp"
                                        android:layout_height="7dp"
                                        android:layout_marginEnd="5dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/live_graph_direct"
                                        android:textColor="?android:attr/textColorSecondary"
                                        android:textSize="11sp" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_summary_direct"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFeatureSettings="tnum"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="12.5sp"
                                    android:textStyle="bold"
                                    tools:text="220 MB" />

                                <TextView
                                    android:id="@+id/tv_summary_direct_detail"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="10sp"
                                    tools:text="↓ 200 MB  ↑ 20 MB" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="8dp"
                            android:background="#1A808080"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/summary_bar_proxy"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0" />

                            <View
                                android:id="@+id/summary_bar_direct"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0" />

                            <View
                                android:id="@+id/summary_bar_empty"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Daily Trend Stacked Bar Chart (shown in By Date mode) -->
                    <io.nekohasekai.sagernet.widget.DailyBarChartView
                        android:id="@+id/daily_bar_chart"
                        android:layout_width="match_parent"
                        android:layout_height="112dp"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Dimension Switcher -->
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/stats_dimension_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_dim_daily"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/traffic_stats_dim_daily"
                            android:textAllCaps="false"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_dim_profile"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/traffic_stats_dim_profile"
                            android:textAllCaps="false"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_dim_app"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/traffic_stats_dim_app"
                            android:textAllCaps="false"
                            android:textSize="12sp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- Sortable Table Column Headers -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#0D808080"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/tv_table_col_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.35"
                            android:text="@string/traffic_stats_col_date"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_table_col_1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.85"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="end"
                            android:text="@string/live_graph_proxy"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_table_col_2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.85"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="end"
                            android:text="@string/live_graph_direct"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_table_col_total"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.9"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="end"
                            android:text="@string/live_graph_total"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/stats_table_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="?android:attr/listDivider"
                        android:orientation="vertical"
                        android:showDividers="middle" />

                    <TextView
                        android:id="@+id/tv_stats_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="24dp"
                        android:text="@string/traffic_stats_empty"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_stats_expand"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAllCaps="false"
                        android:textSize="12.5sp"
                        android:visibility="gone"
                        tools:text="显示全部 (32)" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
