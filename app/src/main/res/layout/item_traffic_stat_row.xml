<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingTop="7dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/stat_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.35"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="12.5sp"
                android:textStyle="bold"
                tools:text="Telegram" />

            <TextView
                android:id="@+id/stat_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="10.5sp"
                android:visibility="gone"
                tools:text="VLESS · Reality"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/stat_col1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.85"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11.5sp"
            tools:text="124 MB" />

        <TextView
            android:id="@+id/stat_col2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.85"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11.5sp"
            tools:text="18 MB" />

        <TextView
            android:id="@+id/stat_total"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="142 MB" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/stat_bar_track"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="5dp"
        android:background="#14808080"
        android:orientation="horizontal">

        <View
            android:id="@+id/stat_bar_primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0" />

        <View
            android:id="@+id/stat_bar_secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0" />

        <View
            android:id="@+id/stat_bar_rest"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
