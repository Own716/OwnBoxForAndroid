<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvLogLevel"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tag_pill"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="#3B82F6"
        android:textStyle="bold"
        tools:text="INFO" />

    <TextView
        android:id="@+id/tvLogTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/primaryOrTextSecondary"
        tools:text="14:30:12" />

    <TextView
        android:id="@+id/tvLogMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/primaryOrTextPrimary"
        tools:text="[router] matched rule DomainSuffix(google.com) -> proxy" />

</LinearLayout>
