<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/core_settings">

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="cn"
            app:entries="@array/smart_route_country_entries"
            app:entryValues="@array/smart_route_country_values"
            app:icon="@drawable/solar_global_linear"
            app:key="smartRouteCountry"
            app:title="@string/smart_route_country"
            app:useSimpleSummaryProvider="true" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="1"
            app:entries="@array/traffic_sniffing_values"
            app:entryValues="@array/int_array_2"
            app:icon="@drawable/ic_baseline_manage_search_24"
            app:key="trafficSniffing"
            app:title="@string/traffic_sniffing"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:icon="@drawable/solar_shield_warning_linear"
            app:key="blockQuic"
            app:summary="@string/block_quic_summary"
            app:title="@string/block_quic" />

        <SwitchPreferenceCompat
            app:icon="@drawable/baseline_wrap_text_24"
            app:key="resolveDestination"
            app:summary="@string/resolve_destination_summary"
            app:title="@string/resolve_destination" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="0"
            app:entries="@array/ipv6_mode"
            app:entryValues="@array/int_array_4"
            app:icon="@drawable/solar_server_square_linear"
            app:key="ipv6Mode"
            app:title="@string/ipv6"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:icon="@drawable/solar_bolt_circle_linear"
            app:key="dualNetworkAcceleration"
            app:summary="@string/dual_network_acceleration_summary"
            app:title="@string/dual_network_acceleration" />

        <SwitchPreferenceCompat
            app:icon="@drawable/solar_transmission_linear"
            app:key="concurrentDial"
            app:summary="@string/concurrent_dial_summary"
            app:title="@string/concurrent_dial" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="0"
            app:entries="@array/rules_dat_provider"
            app:entryValues="@array/int_array_5"
            app:icon="@drawable/solar_cloud_storage_linear"
            app:key="rulesProvider"
            app:title="@string/route_rules_provider"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="https://github.com/SagerNet/sing-geosite/releases/latest/download/geosite.db"
            app:key="rulesGeositeUrl"
            app:title="@string/rules_geosite_url"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="https://github.com/SagerNet/sing-geoip/releases/latest/download/geoip.db"
            app:key="rulesGeoipUrl"
            app:title="@string/rules_geoip_url"
            app:useSimpleSummaryProvider="true" />

        <Preference
            app:icon="@drawable/solar_stopwatch_linear"
            app:key="rulesUpdateInterval"
            app:persistent="false"
            app:summary="@string/ruleset_update_interval_summary"
            app:title="@string/ruleset_update_interval" />

    </PreferenceCategory>

</PreferenceScreen>
