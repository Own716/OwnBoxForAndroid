<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="FullBackupContent">
    <cloud-backup>
        <!-- Exclude databases containing sensitive credentials (WebDAV passwords, tokens, nodes) from unencrypted cloud backup -->
        <exclude
            domain="database"
            path="sager_net.db" />
        <exclude
            domain="database"
            path="configuration.db" />
        <exclude
            domain="device_database"
            path="configuration.db" />
    </cloud-backup>
    <device-transfer>
        <!-- Retain encrypted device-to-device migration between user devices -->
        <include
            domain="database"
            path="sager_net.db" />
        <include
            domain="device_database"
            path="configuration.db" />
    </device-transfer>
</data-extraction-rules>
