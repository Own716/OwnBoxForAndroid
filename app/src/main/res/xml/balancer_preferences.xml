<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_social_emoji_symbols"
        app:key="profileName"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <moe.matsuri.nb4a.ui.SimpleMenuPreference
        app:defaultValue="2"
        app:entries="@array/balancer_type_entries"
        app:entryValues="@array/balancer_type_values"
        app:icon="@drawable/ic_baseline_tune_24"
        app:key="balancerType"
        app:title="@string/balancer_source_type"
        app:useSimpleSummaryProvider="true" />

    <Preference
        app:icon="@drawable/ic_baseline_layers_24"
        app:key="balancerTargetGroup"
        app:summary="@string/balancer_no_group_selected"
        app:title="@string/balancer_server_source" />

    <Preference
        app:icon="@drawable/ic_baseline_view_list_24"
        app:key="balancerExplicitNodes"
        app:summary="@string/balancer_explicit_nodes_empty"
        app:title="@string/balancer_explicit_nodes" />

    <io.nekohasekai.sagernet.widget.BalancerNodeListPreference
        app:isPreferenceVisible="false"
        app:key="balancerNodeList" />

    <EditTextPreference
        app:icon="@drawable/ic_baseline_filter_list_24"
        app:key="balancerNameInclude"
        app:title="@string/balancer_name_include" />

    <moe.matsuri.nb4a.ui.SimpleMenuPreference
        app:defaultValue="latency"
        app:entries="@array/balancer_selection_mode_entries"
        app:entryValues="@array/balancer_selection_mode_values"
        app:icon="@drawable/ic_baseline_low_priority_24"
        app:key="balancerSelectionMode"
        app:title="@string/balancer_selection_mode" />

    <SwitchPreferenceCompat
        app:defaultValue="false"
        app:icon="@drawable/ic_baseline_shuffle_24"
        app:key="balancerBalanceEnabled"
        app:summary="@string/balancer_balance_enabled_off_sum"
        app:title="@string/balancer_balance_enabled" />

    <Preference
        app:icon="@drawable/ic_baseline_info_24"
        app:key="balancerMatchSummary"
        app:selectable="false"
        app:summary="@string/balancer_match_summary_empty"
        app:title="@string/balancer_preview_title" />

    <Preference
        app:icon="@drawable/ic_baseline_keyboard_arrow_down_24"
        app:key="balancerAdvancedToggle"
        app:summary="@string/balancer_advanced_show"
        app:title="@string/balancer_advanced_title" />

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:isPreferenceVisible="false"
        app:key="balancerCatUseWhich"
        app:title="@string/balancer_cat_use_which">

        <EditTextPreference
            app:iconSpaceReserved="false"
            app:key="balancerCountryFilter"
            app:title="@string/balancer_country_filter" />

        <EditTextPreference
            app:iconSpaceReserved="false"
            app:key="balancerNameExclude"
            app:title="@string/balancer_name_exclude" />

        <EditTextPreference
            app:defaultValue="300"
            app:iconSpaceReserved="false"
            app:key="balancerRunTopN"
            app:title="@string/balancer_run_top_n" />

        <EditTextPreference
            app:defaultValue="1440"
            app:iconSpaceReserved="false"
            app:key="balancerResultTrustMinutes"
            app:title="@string/balancer_result_trust_minutes" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="balancerSkipFailedWithinTrust"
            app:summary="@string/balancer_skip_failed_within_trust_sum"
            app:title="@string/balancer_skip_failed_within_trust" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:isPreferenceVisible="false"
        app:key="balancerCatHealth"
        app:title="@string/balancer_cat_health">

        <EditTextPreference
            app:defaultValue="3"
            app:iconSpaceReserved="false"
            app:key="balancerStandbySize"
            app:title="@string/balancer_standby_size" />

        <EditTextPreference
            app:defaultValue="8"
            app:iconSpaceReserved="false"
            app:key="balancerIntensiveCheckCount"
            app:title="@string/balancer_intensive_check_count" />

        <EditTextPreference
            app:defaultValue="300"
            app:iconSpaceReserved="false"
            app:key="balancerInterval"
            app:title="@string/balancer_interval_title" />

        <EditTextPreference
            app:defaultValue="600"
            app:iconSpaceReserved="false"
            app:key="balancerFullScanIntervalSec"
            app:title="@string/balancer_full_scan_interval" />

        <EditTextPreference
            app:defaultValue="15"
            app:iconSpaceReserved="false"
            app:key="balancerWatchIntervalSec"
            app:title="@string/balancer_watch_interval" />

        <EditTextPreference
            app:defaultValue="10"
            app:iconSpaceReserved="false"
            app:key="balancerSampleCount"
            app:title="@string/balancer_sample_count" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:isPreferenceVisible="false"
        app:key="balancerCatSwitching"
        app:title="@string/balancer_cat_switching">

        <EditTextPreference
            app:defaultValue="30"
            app:iconSpaceReserved="false"
            app:key="balancerTolerance"
            app:title="@string/balancer_tolerance_title" />

        <EditTextPreference
            app:defaultValue="0"
            app:iconSpaceReserved="false"
            app:key="balancerMaxRttMs"
            app:title="@string/balancer_max_rtt" />

        <EditTextPreference
            app:defaultValue="2"
            app:iconSpaceReserved="false"
            app:key="balancerDialRetries"
            app:title="@string/balancer_dial_retries" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="balancerInterruptOnSwitch"
            app:summary="@string/balancer_interrupt_on_switch_sum"
            app:title="@string/balancer_interrupt_on_switch" />

        <EditTextPreference
            app:defaultValue="3"
            app:iconSpaceReserved="false"
            app:key="balancerFailbackChecks"
            app:title="@string/balancer_failback_checks" />

        <EditTextPreference
            app:defaultValue="60"
            app:iconSpaceReserved="false"
            app:key="balancerFailbackDelaySec"
            app:title="@string/balancer_failback_delay" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="balancerInterruptOnFailback"
            app:summary="@string/balancer_interrupt_on_failback_sum"
            app:title="@string/balancer_interrupt_on_failback" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="balancerLearnFromConnections"
            app:summary="@string/balancer_learn_from_connections_sum"
            app:title="@string/balancer_learn_from_connections" />

        <EditTextPreference
            app:defaultValue="60"
            app:iconSpaceReserved="false"
            app:key="balancerSiteStickyMinutes"
            app:title="@string/balancer_site_sticky_minutes" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:isPreferenceVisible="false"
        app:key="balancerCatLoadBalance"
        app:title="@string/balancer_cat_load_balance">

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="timed_rotation"
            app:entries="@array/balancer_balance_mode_entries"
            app:entryValues="@array/balancer_balance_mode_values"
            app:iconSpaceReserved="false"
            app:key="balancerBalanceMode"
            app:title="@string/balancer_balance_mode_title"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="30"
            app:iconSpaceReserved="false"
            app:key="balancerBalanceIntervalSec"
            app:title="@string/balancer_balance_interval" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:isPreferenceVisible="false"
        app:key="balancerCatEndpoints"
        app:title="@string/balancer_cat_endpoints">

        <EditTextPreference
            app:iconSpaceReserved="false"
            app:key="balancerTestUrl"
            app:title="@string/balancer_test_url_title" />

        <EditTextPreference
            app:iconSpaceReserved="false"
            app:key="balancerConnectivityUrl"
            app:title="@string/balancer_connectivity_url" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:isPreferenceVisible="false"
        app:key="balancerCatChain"
        app:title="@string/balancer_cat_chain">

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="balancerUseFrontProxy"
            app:title="@string/balancer_use_front_proxy" />

        <io.nekohasekai.sagernet.widget.OutboundPreference
            app:iconSpaceReserved="false"
            app:key="balancerFrontProxy"
            app:title="@string/front_proxy"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="balancerUseLandingProxy"
            app:title="@string/balancer_use_landing_proxy" />

        <io.nekohasekai.sagernet.widget.OutboundPreference
            app:iconSpaceReserved="false"
            app:key="balancerLandingProxy"
            app:title="@string/landing_proxy"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

</PreferenceScreen>
