<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/vpn_settings">

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/solar_restart_circle_linear"
            app:key="isAutoConnect"
            app:summary="@string/auto_connect_summary"
            app:title="@string/auto_connect" />

        <SwitchPreferenceCompat
            app:icon="@drawable/ic_navigation_apps"
            app:key="proxyApps"
            app:summary="@string/proxied_apps_summary"
            app:title="@string/proxied_apps" />

        <SwitchPreferenceCompat
            app:icon="@drawable/solar_routing_2_linear"
            app:key="bypassLan"
            app:title="@string/route_opt_bypass_lan" />

        <SwitchPreferenceCompat
            app:icon="@drawable/solar_cpu_linear"
            app:key="bypassLanInCore"
            app:title="@string/bypass_lan_in_core" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:icon="@drawable/ic_baseline_security_24"
            app:key="strictRoute"
            app:summary="@string/strict_route_sum"
            app:title="@string/strict_route" />

        <SwitchPreferenceCompat
            app:icon="@drawable/solar_pie_chart_2_linear"
            app:key="meteredNetwork"
            app:summary="@string/metered_summary"
            app:title="@string/metered" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="3"
            app:entries="@array/tun_implementation"
            app:entryValues="@array/int_array_4"
            app:icon="@drawable/solar_tuning_square_2_linear"
            app:key="tunImplementation"
            app:title="@string/tun_implementation" />

        <moe.matsuri.nb4a.ui.MTUPreference
            app:defaultValue="1400"
            app:entries="@array/mtu_select"
            app:entryValues="@array/mtu_select"
            app:icon="@drawable/solar_ruler_angular_linear"
            app:key="mtu"
            app:title="@string/mtu" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:icon="@drawable/solar_shield_warning_linear"
            app:key="block_quic"
            app:summary="拦截走代理的 UDP 443 (QUIC) 强制回退至 TCP，放行国内直连"
            app:title="拦截代理 QUIC (UDP 443)" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/solar_wi_fi_router_linear"
            app:key="trusted_network_smart_enabled"
            app:summary="连入家庭/公司等受信任 Wi-Fi 或内网时自动暂停代理，离开后自动恢复"
            app:title="受信任网络智能启停" />

    </PreferenceCategory>

</PreferenceScreen>
