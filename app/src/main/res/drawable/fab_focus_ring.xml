<?xml version="1.0" encoding="utf-8"?>
<!-- D-pad focus on the FAB (TV): a dark ring with a white one inside shows on any FAB colour. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke
                        android:width="3dp"
                        android:color="#99000000" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:left="3dp"
                android:right="3dp"
                android:top="3dp">
                <shape android:shape="oval">
                    <stroke
                        android:width="2dp"
                        android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
