<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Milk Glass Material with Smooth Super-ellipse Radius -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="135"
                android:startColor="#EEFFFFFF"
                android:centerColor="#E6F8FAFC"
                android:endColor="#D9EDF2F7"
                android:type="linear" />
        </shape>
    </item>
    <!-- Fluid Specular Inner Glow Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1.5dp"
                android:color="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>