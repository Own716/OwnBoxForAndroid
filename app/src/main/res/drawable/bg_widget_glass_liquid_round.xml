<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Liquid Glass Spherical Droplet Base -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#35FFFFFF"
                android:centerColor="#28FFFFFF"
                android:endColor="#1EFFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Spherical Caustic Specular Gleam -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#60FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Spherical Refraction Rim -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
