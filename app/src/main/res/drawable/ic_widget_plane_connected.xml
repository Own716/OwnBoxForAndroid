<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Circular Emerald Green Gradient Background -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#10B981"
                android:endColor="#059669"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#80A7F3D0" />
        </shape>
    </item>
    <!-- Paper Airplane Icon from ic_service_busy -->
    <item
        android:drawable="@drawable/ic_service_busy"
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp" />
</layer-list>
