<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/spinner_dropdown_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/spinner_dropdown_stroke" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_spinner_dropdown_arrow"
        android:width="20dp"
        android:height="20dp"
        android:gravity="end|center_vertical"
        android:end="12dp" />
</layer-list>
